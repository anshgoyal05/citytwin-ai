# CityTwin AI — Environment Configuration Template
# Copy this file to .env and configure your local or hosted credentials.

# ------------------------------------------------------------------------------
# 1. Supabase & PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Hosted Supabase project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous Client Key (Safe for browser/frontend usage)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Secret Key (Server-only / Elevated administration permissions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Direct PostgreSQL Connection URI (for migrations, seed scripts, or Prisma/TypeORM)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Express Backend API Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# 3. Model & Cache Configuration
# ------------------------------------------------------------------------------
ENABLE_POSTGIS_CACHE=true
BENCHMARK_ITERATIONS=1000
TEST_ITERATIONS_PER_COMPONENT=200

# ------------------------------------------------------------------------------
# 4. Map & Basemap Tile Configuration
# ------------------------------------------------------------------------------
# Optional: CARTO Basemap API Key (Get free key at https://carto.com/basemaps/apikey)
# If left blank, the app defaults to watermark-free Apple Minimal Canvas (ESRI Gray) or OSM.
VITE_CARTO_API_KEY=
VITE_MAPBOX_TOKEN=

# ------------------------------------------------------------------------------
# 5. Gemini AI Configuration (TwinMind Spatial Assistant)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get free key at https://aistudio.google.com/app/apikey)
# Enables real-time AI reasoning across Chandigarh's 64 sectors and healthcare models.
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=